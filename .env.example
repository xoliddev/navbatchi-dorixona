# Copy this file to .env and fill in your own values. Never commit .env.

# Token from @BotFather (looks like 123456789:AA...). Placeholder below is NOT a real token.
BOT_TOKEN=123456789:replace-with-your-token-from-BotFather

# Public HTTPS address of the Mini App, ending in /webapp/ (for example a free cloudflared tunnel).
# Leave empty to run the bot without the map button.
WEBAPP_URL=

# Telegram user ids of admins (comma separated). Admins add pharmacies and invite pharmacists.
# Find yours with @userinfobot. Example: ADMIN_IDS=111111111,222222222
ADMIN_IDS=

# Where the SQLite file lives (the folder is created automatically).
DB_PATH=data/dorixona.db
# Fill an empty database with the fictional demo city (16 pharmacies, 26 medicines). 0 = start empty.
SEED_DEMO=1

# Web server for the Mini App and its API.
HOST=0.0.0.0
PORT=8080

# Mini App login data older than this many seconds is refused.
INITDATA_MAX_AGE=3600
# Actions per user per minute (bot buttons and API calls).
RATE_PER_MINUTE=30
# How often expired reservations are released and price alerts checked, in seconds.
SCHEDULER_INTERVAL=30
# Pharmacist invite links expire after this many hours.
INVITE_HOURS=72
LOG_LEVEL=INFO
